# ============================================================================
# Environment template — copy to .env.development / .env.staging / .env.production
# and fill real values. NEVER commit real secrets. NEVER reuse prod credentials
# in development (spec §34).
# ============================================================================

# --- Application -------------------------------------------------------------
NODE_ENV=development                 # development | test | staging | production
PORT=3000
API_PREFIX=api
PUBLIC_BASE_URL=http://localhost:3000
LOG_LEVEL=debug                      # debug | info | warn | error
SWAGGER_ENABLED=true                 # MUST be false in production unless protected

# --- Database (PostgreSQL — source of truth, spec §3/§29) --------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB?schema=public
DATABASE_URL=postgresql://fashion:fashion@localhost:5432/fashion_dev

# --- Cache / ephemeral data (Redis — spec §3) --------------------------------
# Redis holds OTPs, rate limits, locks and caches. NEVER authoritative data.
REDIS_URL=redis://localhost:6379/0

# --- Secrets (generate with: openssl rand -hex 32) ---------------------------
# 32+ hex chars required in production (enforced at boot).
JWT_ACCESS_SECRET=change-me-access-secret-32-chars-min
OTP_HASH_PEPPER=change-me-otp-pepper-32-chars-min
AUDIT_HASH_KEY=change-me-audit-key-32-chars-min
DATA_ENCRYPTION_KEY=change-me-encryption-32-chars  # AES-256-GCM key for sensitive identity data

# --- Auth / sessions ----------------------------------------------------------
ACCESS_TOKEN_TTL_SECONDS=900         # 15 minutes
REFRESH_TOKEN_TTL_DAYS=30
AUTH_COOKIE_DOMAIN=                  # empty = host-only cookie; set for prod domain
AUTH_COOKIE_SECURE=auto              # auto | true | false (auto: true when NODE_ENV=production)

# --- OTP -----------------------------------------------------------------------
OTP_TTL_SECONDS=180
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_REQUEST_HOURLY_LIMIT=5

# --- CORS (comma-separated exact origins; no wildcards in production) ----------
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# --- External providers (abstractions — real credentials only in prod, spec §40)
PAYMENT_PROVIDER=mock               # mock | zarinpal
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true

SMS_PROVIDER=console                # console | kavenegar
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
KAVENEGAR_OTP_TEMPLATE=otp

EMAIL_PROVIDER=console              # console | smtp (later)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@example.com

IDENTITY_PROVIDER=mock              # mock | (future Iranian KYC providers)
SHIPPING_PROVIDER=mock

# --- Storage --------------------------------------------------------------------
STORAGE_PROVIDER=local              # local | s3
LOCAL_STORAGE_DIR=./uploads
PUBLIC_CDN_BASE_URL=http://localhost:3000/static
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Business rules (server-side authority, spec §5/§11) ------------------------
ORDER_PAYMENT_WINDOW_MINUTES=30     # stock reservation window for PENDING_PAYMENT orders
RETURN_WINDOW_DAYS=7
MAX_QTY_PER_ORDER_LINE=10
MAX_CART_ITEMS=50
VAT_RATE_PERCENT=0                  # 0 = prices are VAT-inclusive (ADR-0009)
REVIEW_REQUIRES_VERIFIED_PURCHASE=false
REVIEW_MODERATION_ENABLED=true
ONE_COUPON_PER_ORDER=true

# --- Admin bootstrap (one-time; audit-logged) -----------------------------------
# SUPER_ADMIN bootstrap runs: npm run seed — requires this secret from env.
ADMIN_BOOTSTRAP_SECRET=change-me-bootstrap-secret

# --- Pagination guard -------------------------------------------------------------
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
